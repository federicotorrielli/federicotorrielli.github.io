---
import { siGithub, siInstagram, siGooglescholar } from "simple-icons";

interface Props {
  name: "mail" | "scholar" | "github" | "linkedin" | "instagram" | "pin" | "arrow" | "external" | "pdf" | "code";
  size?: number;
}
const { name, size = 20 } = Astro.props;

const brand: Record<string, string> = {
  github: siGithub.path,
  instagram: siInstagram.path,
  scholar: siGooglescholar.path,
};
const stroke: Record<string, string> = {
  mail: "M3 6h18v12H3zM3 7l9 6 9-6",
  pin: "M12 21s-7-6.3-7-11.5A7 7 0 0 1 19 9.5C19 14.7 12 21 12 21zM12 12.2a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2z",
  arrow: "M4 12h15M13 6l6 6-6 6",
  external: "M14 4h6v6M20 4l-9 9M18 14v6H4V6h6",
  pdf: "M6 3h8l5 5v13H6zM14 3v5h5M9 13h6M9 17h4",
  code: "M8 7l-5 5 5 5M16 7l5 5-5 5",
};
---
{name === "linkedin" ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    <rect x="2" y="2" width="20" height="20" rx="2.5" fill="currentColor" />
    <path d="M6.5 10v7.5M6.5 6.6v.2M10.5 17.5V10M10.5 13.2c0-2 1.3-3.2 3-3.2s3 1 3 3.2v4.3" stroke="var(--sheet, #fff)" stroke-width="2.2" stroke-linecap="round" fill="none" />
  </svg>
) : brand[name] ? (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={brand[name]} /></svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={stroke[name]} /></svg>
)}
