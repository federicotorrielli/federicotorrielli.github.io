---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Page not found">
  <section class="wrap lost" data-enter>
    <p class="eyebrow" style="--i:0">Error 404</p>
    <h1 style="--i:1">Page not found</h1>
    <p class="lead" style="--i:2">This page does not exist. Probably it moved when I rebuilt the website.</p>
    <div style="--i:3"><a class="btn" href="/">Home page</a></div>
  </section>
</Base>
<style>
  .lost { display: grid; gap: 1.4rem; justify-items: start; padding-block: clamp(5rem, 14vw, 10rem); }
  .lost > * { margin: 0; }
</style>
